<!-- Search Container -->
<div class="search-bar-container">
  <div class="search-box">
    <input
      (input)="onSearchInputChange($event)"
      (keypress)="onKeyPress($event)"
      [(ngModel)]="searchQuery"
      class="search-input form-control"
      placeholder="Cerca eventi e utenti..."
      type="text">
      <i (click)="onSearchClick()"
          class="fas fa-search search-icon"
          title="Cerca"></i>
      <i (click)="clearSearch()"
          *ngIf="searchQuery && isSearchMode"
          class="fas fa-times clear-icon"
          title="Cancella ricerca"></i>
  </div>

  <!-- Search Results Info -->
  <div class="results-container">
    <div *ngIf="!isLoading && !hasError && searchQuery && (isSearchMode && results.length > 0)" class="search-results-dropdown">
      <p class="results-text" *ngIf="isSearchMode">
        <strong>{{ totalElements }}</strong>
        {{ totalElements === 1 ? 'risultato trovato' : 'risultati trovati' }}
        per "<em>{{ searchQuery }}</em>"
      </p>
    </div>


    <!-- Results List -->
    <div *ngIf="!isLoading && !hasError" class="number-of-results-container">
      <!-- No Results -->
      <div *ngIf="results.length === 0 && isSearchMode && searchQuery" class="no-results">
        <div class="text-center">
          <i class="fas fa-search fa-3x text-muted"></i>
          <h4 class="text-muted">Nessun risultato trovato per "<em>{{ searchQuery }}</em>"</h4>
          <p class="text-muted">
            Prova a modificare i termini di ricerca
          </p>
        </div>
      </div>


      <!-- Simple Results List -->
      <div *ngIf="results.length > 0" class="element-names-list">
        <div class="scrollbar"></div>
        <div *ngFor="let result of results" class="element-name-item">

          <!-- User Item -->
          <div *ngIf="isUser(result)" class="d-flex justify-content-between align-items-center p-3 border rounded mt-1">
            <div>
              <h5 class="username-text">
                <i class="fas fa-user text-primary"></i>
                &#64;{{ getUserUsername(result) }}
              </h5>
              <small class="text-muted">{{ result.nome }}</small>
            </div>
            <button class="btn btn-outline-primary btn-sm">
              <i class="fas fa-user-circle"></i>
              Profilo
            </button>
          </div>

          <!-- Event Item -->
          <div *ngIf="isEvent(result)" class="d-flex justify-content-between align-items-center p-3 border rounded mt-1">
            <div>
              <h5 class="event-text">
                <i class="fas fa-calendar-alt text-success me-2"></i>
                {{ result.nome }}
              </h5>
              <p><small class="text-muted">{{ formatDate(getEventDate(result)) }}</small></p>
              <p><small class="text-muted">{{ formatPrice(getEventPrice(result)) }}</small></p>
            </div>
            <button class="btn btn-outline-success btn-sm">
              <i class="fas fa-eye"></i>
              Dettagli
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
