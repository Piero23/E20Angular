.hero-container {
  position: relative;
  height: 66vh;
  width: 100vw;

  /*Flyers zone style*/
  .flyers-container {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    width: 100vw;
    height: 66vh;

    .flyer img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
  }

  .flyers-container::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(to bottom,
        rgba(0, 0, 0, 0.7) 0%,
        rgba(0, 0, 0, 0.5) 100%);
    z-index: 1;
  }
}
